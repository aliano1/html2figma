{
  "name": "html2figma",
  "version": "0.3.0",
  "private": true,
  "description": "Capture any rendered web page (bookmarklet) and rebuild it as editable Figma layers (plugin).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs && node test/build.test.mjs && node test/server.test.mjs",
    "start": "node server/index.mjs",
    "dev:server": "H2F_ALLOW_ANON=1 node server/index.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}